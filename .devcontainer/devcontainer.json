{
  "name": "Terminalen",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "hostRequirements": {
    "cpus": 2
  },
  "waitFor": "postCreateCommand",
  "postCreateCommand": "npm install",
  "postAttachCommand": {
    "app": "bash scripts/codespace-start.sh"
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Terminalen",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {
        "workbench.startupEditor": "none",
        "git.autofetch": true
      }
    }
  }
}
